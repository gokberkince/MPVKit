+                // VideoToolbox refuses field-coded H.264 outright: every load of an
+                // interlaced broadcast paid a doomed VTDecompressionSession and a
+                // "Failed setup … / no frame!" pair per attempt before falling back to
+                // software. The container already said the stream is field-coded, so
+                // don't audition a decoder that is known to walk out.
+                if (ctx->codec->interlaced_hint && strcmp(codec, "h264") == 0 &&
+                    bstr_startswith0(bstr0(hwdec->name), "videotoolbox"))
+                {
+                    MP_VERBOSE(vd, "Skipping %s: field-coded H.264.\n", hwdec->name);
+                    continue;
+                }
+
