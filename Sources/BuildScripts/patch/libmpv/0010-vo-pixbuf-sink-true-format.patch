+// The CoreVideo format for a mirrored SOFTWARE frame. The RANGE has to follow the source: the
+// view above carries the source's levels onto the destination, so `mp_sws_scale` converts format
+// and never levels — and full-range pixels written into a buffer whose format type SAYS limited
+// are described that way to the display layer and come back crushed.
+static OSType tap_sw_cvfmt(const struct mp_image_params *p)
+{
+    return p->repr.levels == PL_COLOR_LEVELS_FULL
+        ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+        : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+}
+
+// What `CVBufferPropagateAttachments` gives the hardware path for free, spelled out for a buffer
+// this file just created. `CMVideoFormatDescriptionCreateForImageBuffer` builds the display
+// layer's format description from exactly these attachments, and a buffer carrying none of them
+// leaves the layer to GUESS from the frame size — 601 below standard definition, 709 above it.
+// Interlaced broadcast never hardware-decodes, so the software path is where BT.2020 and HLG
+// actually turn up, and those were mirrored in the wrong colours.
+//
+// Only exact mappings are written. An attachment nobody can be sure of is worse than the layer's
+// own guess, so anything unrecognised is left absent on purpose.
+static void tap_set_color_attachments(CVPixelBufferRef pb, const struct mp_image_params *p)
+{
+    CFStringRef matrix = NULL, primaries = NULL, transfer = NULL, chroma = NULL;
+    switch (p->repr.sys) {
+    case PL_COLOR_SYSTEM_BT_601:     matrix = kCVImageBufferYCbCrMatrix_ITU_R_601_4; break;
+    case PL_COLOR_SYSTEM_BT_709:     matrix = kCVImageBufferYCbCrMatrix_ITU_R_709_2; break;
+    case PL_COLOR_SYSTEM_BT_2020_NC: matrix = kCVImageBufferYCbCrMatrix_ITU_R_2020;  break;
+    default: break;
+    }
+    switch (p->color.primaries) {
+    case PL_COLOR_PRIM_BT_601_525: primaries = kCVImageBufferColorPrimaries_SMPTE_C;     break;
+    case PL_COLOR_PRIM_BT_601_625: primaries = kCVImageBufferColorPrimaries_EBU_3213;    break;
+    case PL_COLOR_PRIM_BT_709:     primaries = kCVImageBufferColorPrimaries_ITU_R_709_2; break;
+    case PL_COLOR_PRIM_BT_2020:    primaries = kCVImageBufferColorPrimaries_ITU_R_2020;  break;
+    default: break;
+    }
+    switch (p->color.transfer) {
+    case PL_COLOR_TRC_BT_1886: transfer = kCVImageBufferTransferFunction_ITU_R_709_2;      break;
+    case PL_COLOR_TRC_SRGB:    transfer = kCVImageBufferTransferFunction_sRGB;             break;
+    case PL_COLOR_TRC_PQ:      transfer = kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ; break;
+    case PL_COLOR_TRC_HLG:     transfer = kCVImageBufferTransferFunction_ITU_R_2100_HLG;   break;
+    default: break;
+    }
+    switch (p->chroma_location) {
+    case PL_CHROMA_LEFT:     chroma = kCVImageBufferChromaLocation_Left;    break;
+    case PL_CHROMA_CENTER:   chroma = kCVImageBufferChromaLocation_Center;  break;
+    case PL_CHROMA_TOP_LEFT: chroma = kCVImageBufferChromaLocation_TopLeft; break;
+    default: break;
+    }
+    if (matrix)
+        CVBufferSetAttachment(pb, kCVImageBufferYCbCrMatrixKey, matrix,
+                              kCVAttachmentMode_ShouldPropagate);
+    if (primaries)
+        CVBufferSetAttachment(pb, kCVImageBufferColorPrimariesKey, primaries,
+                              kCVAttachmentMode_ShouldPropagate);
+    if (transfer)
+        CVBufferSetAttachment(pb, kCVImageBufferTransferFunctionKey, transfer,
+                              kCVAttachmentMode_ShouldPropagate);
+    if (chroma)
+        CVBufferSetAttachment(pb, kCVImageBufferChromaLocationTopFieldKey, chroma,
+                              kCVAttachmentMode_ShouldPropagate);
+}
