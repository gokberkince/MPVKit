+// What the mirror is actually being painted on, once per distinct buffer. Keyed on the shape
+// rather than fired once, so a run prints for the hardware decoder and prints AGAIN the moment
+// iOS takes the session away and mpv drops into software — the two paths side by side in one log,
+// and nothing per frame. The predecessor of this line measured where libass put the text and
+// proved it centred, which is precisely how the fault was traced past the layout and into the
+// destination: same canvas, same numbers, two different results, and the only remaining variable
+// was how many bytes a sample takes. `fmt` is the answer.
+static void tap_log_buffer(struct vo *vo, CVPixelBufferRef pb, struct mp_image *source,
+                           int imgfmt)
+{
+    OSType cv = CVPixelBufferGetPixelFormatType(pb);
+    uint64_t key = ((uint64_t)cv << 32)
+                 ^ ((uint64_t)CVPixelBufferGetWidth(pb) << 20)
+                 ^ ((uint64_t)CVPixelBufferGetHeight(pb) << 4)
+                 ^ (uint64_t)CVPixelBufferGetBytesPerRow(pb);
+    if (vo->in->tap_buffer_key == key)
+        return;
+    vo->in->tap_buffer_key = key;
+    MP_WARN(vo, "pip-sub buffer: cv %c%c%c%c %zux%zu planes %zu pitch %zu/%zu -> fmt %s | "
+                "img %dx%d %s[%s] crop %d,%d-%d,%d par %d:%d\n",
+            (char)(cv >> 24), (char)(cv >> 16), (char)(cv >> 8), (char)cv,
+            CVPixelBufferGetWidth(pb), CVPixelBufferGetHeight(pb),
+            CVPixelBufferGetPlaneCount(pb),
+            CVPixelBufferGetBytesPerRowOfPlane(pb, 0),
+            CVPixelBufferGetBytesPerRowOfPlane(pb, 1),
+            imgfmt ? mp_imgfmt_to_name(imgfmt) : "REFUSED",
+            source->w, source->h,
+            mp_imgfmt_to_name(source->params.imgfmt),
+            mp_imgfmt_to_name(source->params.hw_subfmt),
+            source->params.crop.x0, source->params.crop.y0,
+            source->params.crop.x1, source->params.crop.y1,
+            source->params.p_w, source->params.p_h);
 }
 
