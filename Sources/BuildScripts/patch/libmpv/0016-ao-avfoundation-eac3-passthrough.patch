+#define IEC61937_EAC3 21
+#define EAC3_FRAME_SAMPLES 1536
+// The IEC link runs at 4x, so one 100 ms read is 192000/10 * 4 B = 76.8 KiB; the buffer
+// holds two reads plus a carried burst with room to spare.
+#define EAC3_BURST_BUF_MAX 262144
+
+struct eac3_memory_file {
+    const uint8_t *data;
+    UInt32 size;
+};
+
+static OSStatus eac3_read_memory(void *opaque, SInt64 position, UInt32 request,
+                                 void *buffer, UInt32 *actual)
+{
+    struct eac3_memory_file *source = opaque;
+    if (position < 0 || position >= source->size) {
+        *actual = 0;
+        return noErr;
+    }
+
+    UInt32 available = source->size - (UInt32)position;
+    *actual = MPMIN(request, available);
+    memcpy(buffer, source->data + position, *actual);
+    return noErr;
+}
+
+static SInt64 eac3_memory_size(void *opaque)
+{
+    return ((struct eac3_memory_file *)opaque)->size;
+}
+
+// A bare ec-3 ASBD describes only the compatible 5.1 bed. Apple's AudioFile parser derives
+// the dec3 magic cookie and base channel layout from the compressed syncframe; CoreMedia then
+// reconstructs the richer ec+3/JOC format list from those two pieces. No decode or re-encode
+// happens here: the source packet itself remains byte-identical.
+static void probe_eac3_description(struct ao *ao, const uint8_t *data, UInt32 size)
+{
+    struct priv *p = ao->priv;
+    p->eac3_description_probed = true;
+
+    struct eac3_memory_file source = {data, size};
+    AudioFileID file = NULL;
+    void *cookie = NULL;
+    AudioChannelLayout *layout = NULL;
+    CMAudioFormatDescriptionRef description = NULL;
+
+    OSStatus err = AudioFileOpenWithCallbacks(&source, eac3_read_memory, NULL,
+        eac3_memory_size, NULL, kAudioFileAC3Type, &file);
+    if (err != noErr) {
+        MP_WARN(ao, "eac3: Apple parser rejected the first access unit (%d); "
+                "using the compatible base description\n", (int)err);
+        goto done;
+    }
+
+    AudioStreamBasicDescription asbd = {0};
+    UInt32 asbd_size = sizeof(asbd);
+    if ((err = AudioFileGetProperty(file, kAudioFilePropertyDataFormat,
+                                    &asbd_size, &asbd)) != noErr)
+        goto property_error;
+
+    UInt32 cookie_size = 0;
+    if ((err = AudioFileGetPropertyInfo(file, kAudioFilePropertyMagicCookieData,
+                                        &cookie_size, NULL)) != noErr || !cookie_size)
+        goto property_error;
+    cookie = talloc_size(NULL, cookie_size);
+    if (!cookie)
+        goto done;
+    if ((err = AudioFileGetProperty(file, kAudioFilePropertyMagicCookieData,
+                                    &cookie_size, cookie)) != noErr)
+        goto property_error;
+
+    UInt32 layout_size = 0;
+    if ((err = AudioFileGetPropertyInfo(file, kAudioFilePropertyChannelLayout,
+                                        &layout_size, NULL)) != noErr || !layout_size)
+        goto property_error;
+    layout = talloc_size(NULL, layout_size);
+    if (!layout)
+        goto done;
+    if ((err = AudioFileGetProperty(file, kAudioFilePropertyChannelLayout,
+                                    &layout_size, layout)) != noErr)
+        goto property_error;
+
+    // ad_spdif may aggregate several short E-AC-3 syncframes into one 1536-sample IEC burst.
+    // That whole access unit is one sample at this AO boundary, irrespective of the first raw
+    // syncframe's numblkscod value reported by AudioFile.
+    asbd.mSampleRate = p->eac3_rate;
+    asbd.mFramesPerPacket = EAC3_FRAME_SAMPLES;
+    if ((err = CMAudioFormatDescriptionCreate(NULL, &asbd, layout_size, layout,
+            cookie_size, cookie, NULL, &description)) != noErr) {
+        MP_WARN(ao, "eac3: failed to create signalled format description (%d); "
+                "using the compatible base description\n", (int)err);
+        goto done;
+    }
+
+    bool has_joc = false;
+    size_t format_list_size = 0;
+    const AudioFormatListItem *format_list =
+        CMAudioFormatDescriptionGetFormatList(description, &format_list_size);
+    for (size_t n = 0; n < format_list_size / sizeof(*format_list); n++) {
+        if (format_list[n].mASBD.mFormatID == 'ec+3') {
+            has_joc = true;
+            break;
+        }
+    }
+
+    CFRelease(p->format_description);
+    p->format_description = description;
+    description = NULL;
+    MP_INFO(ao, "eac3: Apple format signalling ready (cookie=%u, JOC=%s)\n",
+            cookie_size, has_joc ? "yes" : "no");
+    goto done;
+
+property_error:
+    MP_WARN(ao, "eac3: incomplete Apple format metadata (%d); "
+            "using the compatible base description\n", (int)err);
+done:
+    if (description)
+        CFRelease(description);
+    if (file)
+        AudioFileClose(file);
+    talloc_free(layout);
+    talloc_free(cookie);
+}
+
+// The passthrough lane. ad_spdif hands us IEC 61937 bursts on a 2ch/16bit carrier; each
+// burst holds one 1536-sample E-AC-3 access unit (one or more syncframes), 16-bit
+// byteswapped. Unwrapped and fed as raw kAudioFormatEnhancedAC3 packets — one access unit
+// per sample and explicit 1536-sample timing. The renderer receives the native compressed
+// payload plus Apple's derived JOC signalling; tvOS and the attached route decide the final
+// Dolby MAT/PCM output.
+static void feed_eac3(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    int samplerate = ao->samplerate; // the IEC link rate; frames play at p->eac3_rate
+    int sstride = ao->sstride;
+
+    // The read is CLAMPED to the space left, never guarded after the fact: a request
+    // larger than the remainder would let ao_read_data write past the buffer.
+    int request_sample_count = samplerate / 10;
+    int space = (EAC3_BURST_BUF_MAX - p->burst_len) / sstride;
+    if (request_sample_count > space)
+        request_sample_count = space;
+    if (request_sample_count <= 0) {
+        // A full buffer with no complete burst inside is garbage input, not backlog.
+        MP_WARN(ao, "eac3: burst reassembly stalled, resyncing\n");
+        p->burst_len = 0;
+        return;
+    }
+    void *data[] = {p->burst_buf + p->burst_len};
+
+    int64_t cur_time_av = CMTimeGetNanoseconds([p->synchronizer currentTime]);
+    int64_t cur_time_mp = mp_time_ns();
+    int64_t end_time_av = MPMAX(p->end_time_av, cur_time_av);
+    int64_t time_delta = CMTimeGetNanoseconds(CMTimeMake(request_sample_count, samplerate));
+    bool eof;
+    int real_sample_count = ao_read_data(ao, data, request_sample_count,
+        end_time_av - cur_time_av + cur_time_mp + time_delta, &eof, false, true);
+    if (eof) {
+        [p->renderer stopRequestingMediaData];
+        ao_stop_streaming(ao);
+    }
+    p->burst_len += real_sample_count * sstride;
+
+    int64_t frame_ns = CMTimeGetNanoseconds(CMTimeMake(EAC3_FRAME_SAMPLES, p->eac3_rate));
+    int pos = 0;
+    while (pos + 8 <= p->burst_len) {
+        uint8_t *b = p->burst_buf + pos;
+        // Little-endian preambles F872/4E1F; Pc's low 7 bits name the payload type,
+        // and for type 21 Pd counts BYTES.
+        if (!(b[0] == 0x72 && b[1] == 0xF8 && b[2] == 0x1F && b[3] == 0x4E)) {
+            pos += 2;
+            continue;
+        }
+        int type = b[4] | (b[5] << 8);
+        int bytes = b[6] | (b[7] << 8);
+        if ((type & 0x7F) != IEC61937_EAC3 || bytes <= 0) {
+            pos += 2;
+            continue;
+        }
+        if (pos + 8 + bytes > p->burst_len)
+            break; // burst still arriving
+
+        void *frame = CFAllocatorAllocate(NULL, bytes, 0);
+        uint8_t *src = b + 8;
+        uint8_t *dst = frame;
+        for (int i = 0; i + 1 < bytes; i += 2) {
+            dst[i] = src[i + 1];
+            dst[i + 1] = src[i];
+        }
+        if (bytes % 2)
+            dst[bytes - 1] = src[bytes - 1];
+
+        if (!p->eac3_description_probed)
+            probe_eac3_description(ao, frame, bytes);
+
+        CMBlockBufferRef block = NULL;
+        CMSampleBufferRef sample = NULL;
+        if (CMBlockBufferCreateWithMemoryBlock(NULL, frame, bytes, NULL, NULL, 0,
+                                               bytes, 0, &block) != noErr) {
+            CFAllocatorDeallocate(NULL, frame);
+            MP_ERR(ao, "eac3: failed to create block buffer\n");
+            ao_request_reload(ao);
+            return;
+        }
+        if (p->eac3_pts < 0)
+            p->eac3_pts = MPMAX(cur_time_av, 0);
+        CMSampleTimingInfo timing = {
+            .duration = CMTimeMake(EAC3_FRAME_SAMPLES, p->eac3_rate),
+            .presentationTimeStamp = CMTimeFromNanoseconds(p->eac3_pts),
+            .decodeTimeStamp = kCMTimeInvalid,
+        };
+        size_t frame_size = bytes;
+        if (CMSampleBufferCreateReady(NULL, block, p->format_description, 1, 1, &timing,
+                                      1, &frame_size, &sample) != noErr) {
+            CFRelease(block);
+            MP_ERR(ao, "eac3: failed to create sample buffer\n");
+            ao_request_reload(ao);
+            return;
+        }
+        [p->renderer enqueueSampleBuffer:sample];
+        CFRelease(block);
+        CFRelease(sample);
+        p->eac3_pts += frame_ns;
+        pos += 8 + bytes;
+    }
+    if (pos > 0) {
+        memmove(p->burst_buf, p->burst_buf + pos, p->burst_len - pos);
+        p->burst_len -= pos;
+    }
+
+    time_delta = CMTimeGetNanoseconds(CMTimeMake(real_sample_count, samplerate));
+    p->end_time_av = end_time_av + time_delta;
+
+    if (p->renderer.status == AVQueuedSampleBufferRenderingStatusFailed) {
+        // The gate: a renderer that refuses the stream reloads the chain once; the app
+        // clears its passthrough option on the audio-init failure that follows, and
+        // playback returns as PCM.
+        MP_ERR(ao, "eac3: renderer failed (%s), requesting reload\n",
+               p->renderer.error.localizedDescription.UTF8String ?: "unknown");
+        ao_request_reload(ao);
+    }
+}
+
 static void feed(struct ao *ao)
 {
     struct priv *p = ao->priv;
+    if (p->spdif_eac3) {
+        feed_eac3(ao);
+        return;
+    }
     int samplerate = ao->samplerate;
     int sstride = ao->sstride;

@@ -148,6 +406,8 @@ static void start(struct ao *ao)
     struct priv *p = ao->priv;

     p->end_time_av = -1;
+    p->eac3_pts = -1;
+    p->burst_len = 0;
     [p->synchronizer setRate:1];
     [p->renderer requestMediaDataWhenReadyOnQueue:p->queue usingBlock:^{
         feed(ao);
@@ -227,6 +487,8 @@ - (void)handleRestartNotification:(NSNotification*)notification {
         [p->renderer flush];
         [p->synchronizer setRate:0];
         p->end_time_av = -1;
