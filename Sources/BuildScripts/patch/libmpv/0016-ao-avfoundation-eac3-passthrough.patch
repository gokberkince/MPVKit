 #if HAVE_COREAUDIO
-        MP_FATAL(ao, "please use coreaudio_exclusive instead\n");
+            MP_FATAL(ao, "please use coreaudio_exclusive instead\n");
 #endif
-        goto error;
-    }
-
-    // AVSampleBufferAudioRenderer only supports interleaved formats
-    ao->format = af_fmt_from_planar(ao->format);
-    if (af_fmt_is_planar(ao->format)) {
