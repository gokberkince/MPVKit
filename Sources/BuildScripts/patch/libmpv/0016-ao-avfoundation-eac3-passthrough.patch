-        MP_VERBOSE(ao, "CMAudioFormatDescriptionCreate returned %d\n", err);
-        goto error;
+            goto error;
+        }
+        p->spdif_eac3 = true;
+        // ad_spdif reports the 4x IEC link rate for E-AC-3; the frames play at the
+        // real rate.
+        p->eac3_rate = ao->samplerate >= 176400 ? ao->samplerate / 4 : ao->samplerate;
+        p->eac3_pts = -1;
+        p->burst_buf = talloc_size(p, EAC3_BURST_BUF_MAX);
+
+        AudioStreamBasicDescription asbd = {
+            .mSampleRate = p->eac3_rate,
