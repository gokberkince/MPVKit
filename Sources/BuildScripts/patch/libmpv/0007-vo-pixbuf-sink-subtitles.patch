+
+// An NV12 pixel buffer, addressed as an mp_image so the OSD can be drawn into it. The image is a
+// BORROWED view: no talloc, no refcounted buffers — and `mp_image_is_writeable` answers true for
+// exactly that shape, which is what lets libass blend straight into the caller's pixels.
+// The buffer must be locked by the caller for the life of the view.
+static bool tap_view_nv12(CVPixelBufferRef pb, struct mp_image *view,
+                          const struct mp_image_params *source)
+{
+    if (CVPixelBufferGetPlaneCount(pb) != 2)
+        return false;
+    void *y = CVPixelBufferGetBaseAddressOfPlane(pb, 0);
+    void *uv = CVPixelBufferGetBaseAddressOfPlane(pb, 1);
+    if (!y || !uv)
+        return false;
+
+    *view = (struct mp_image){0};
+    mp_image_setfmt(view, IMGFMT_NV12);
+    mp_image_set_size(view, (int)CVPixelBufferGetWidth(pb),
+                            (int)CVPixelBufferGetHeight(pb));
+    view->planes[0] = y;
+    view->stride[0] = (int)CVPixelBufferGetBytesPerRowOfPlane(pb, 0);
+    view->planes[1] = uv;
+    view->stride[1] = (int)CVPixelBufferGetBytesPerRowOfPlane(pb, 1);
+
+    // The source's colorimetry, but never its format or its crop: this buffer is the whole
+    // picture in NV12, and a crop inherited from a hardware frame would place the subtitles
+    // against a rectangle that does not exist here.
+    struct mp_image_params p = *source;
+    p.imgfmt = IMGFMT_NV12;
+    p.hw_subfmt = 0;
+    p.w = view->w;
+    p.h = view->h;
+    p.crop = (struct mp_rect){0, 0, view->w, view->h};
+    mp_image_set_params(view, &p);
+    return true;
 }
 
+// The decoder's own buffer is not ours to write on — another frame is still being displayed from
+// it — so the composite happens on a copy. NV12 in, NV12 out, IOSurface-backed like the software
+// path's, so the display layer needs no further conversion.
+static void *tap_copy_nv12(CVPixelBufferRef src)
+{
+    if (CVPixelBufferGetPlaneCount(src) != 2)
+        return NULL;
+    CFMutableDictionaryRef attrs = CFDictionaryCreateMutable(NULL, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionaryRef surf = CFDictionaryCreate(NULL, NULL, NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, surf);
+    CFRelease(surf);
+    CVPixelBufferRef dst = NULL;
+    CVReturn err = CVPixelBufferCreate(NULL, CVPixelBufferGetWidth(src),
+        CVPixelBufferGetHeight(src), CVPixelBufferGetPixelFormatType(src), attrs, &dst);
+    CFRelease(attrs);
+    if (err != kCVReturnSuccess || !dst)
+        return NULL;
+    if (CVPixelBufferLockBaseAddress(src, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) {
+        CVPixelBufferRelease(dst);
+        return NULL;
+    }
+    CVPixelBufferLockBaseAddress(dst, 0);
+    for (size_t plane = 0; plane < 2; plane++) {
+        const uint8_t *from = CVPixelBufferGetBaseAddressOfPlane(src, plane);
+        uint8_t *to = CVPixelBufferGetBaseAddressOfPlane(dst, plane);
+        size_t from_pitch = CVPixelBufferGetBytesPerRowOfPlane(src, plane);
+        size_t to_pitch = CVPixelBufferGetBytesPerRowOfPlane(dst, plane);
+        size_t rows = CVPixelBufferGetHeightOfPlane(dst, plane);
+        size_t bytes = MPMIN(from_pitch, to_pitch);
+        if (!from || !to)
+            rows = 0;
+        for (size_t y = 0; y < rows; y++)
+            memcpy(to + y * to_pitch, from + y * from_pitch, bytes);
+    }
+    CVPixelBufferUnlockBaseAddress(dst, 0);
+    CVPixelBufferUnlockBaseAddress(src, kCVPixelBufferLock_ReadOnly);
+    return dst;
+}
+
+// `OSD_DRAW_SUB_ONLY`, never the OSD bar: the app draws its own chrome, and mpv's would arrive in
+// the PiP window as a second set of controls nothing can press. Failure is not fatal anywhere in
+// here — the caller keeps the frame it already has and the mirror simply carries no subtitles.
+static void tap_draw_subtitles(struct vo *vo, CVPixelBufferRef pb,
+                               struct mp_image *source, double pts)
+{
+    if (!vo->osd)
+        return;
+    if (CVPixelBufferLockBaseAddress(pb, 0) != kCVReturnSuccess)
+        return;
+    struct mp_image view;
+    if (tap_view_nv12(pb, &view, &source->params)) {
+        osd_draw_on_image(vo->osd, osd_res_from_image_params(&view.params),
+                          pts, OSD_DRAW_SUB_ONLY, &view);
+    }
+    CVPixelBufferUnlockBaseAddress(pb, 0);
+}
