diff --git a/filters/f_auto_filters.c b/filters/f_auto_filters.c
index 14160aa..04fc08f 100644
--- a/filters/f_auto_filters.c
+++ b/filters/f_auto_filters.c
@@ -1,5 +1,7 @@
 #include <math.h>
 
+#include "config.h"
+
 #include "audio/aframe.h"
 #include "audio/format.h"
 #include "common/common.h"
@@ -121,6 +123,40 @@ static void deint_process(struct mp_filter *f)
         has_filter = false;
     }
 
+#if HAVE_VIDEOTOOLBOX_GL || HAVE_VIDEOTOOLBOX_PL
+    if (!p->sub.filter && !has_filter) {
+        // The frames that most need deinterlacing on Apple never arrive as hw frames:
+        // VideoToolbox refuses field-coded H.264, so interlaced broadcast decodes in
+        // software. Upload once and run the Metal yadif — the output is a VT frame the
+        // vo takes natively, nothing is downloaded back. Any failure here leaves
+        // p->sub.filter unset and the bwdif path below runs unchanged.
+        struct mp_filter *subf = mp_bidir_dummy_filter_create(f);
+        struct mp_filter *filters[2] = {0};
+        bool ok = false;
+
+        struct mp_autoconvert *ac = mp_autoconvert_create(subf);
+        if (ac) {
+            filters[0] = ac->f;
+            mp_autoconvert_add_imgfmt(ac, IMGFMT_NV12, 0);
+            mp_autoconvert_add_imgfmt(ac, IMGFMT_P010, 0);
+            if (mp_autoconvert_probe_input_video(ac, img)) {
+                char *graph = talloc_asprintf(subf,
+                    "hwupload,yadif_videotoolbox=mode=send_field:parity=%s", field_parity);
+                char *args[] = {"graph", graph, NULL};
+                filters[1] =
+                    mp_create_user_filter(subf, MP_OUTPUT_CHAIN_VIDEO, "lavfi", args);
+                if (filters[1]) {
+                    mp_chain_filters(subf->ppins[0], subf->ppins[1], filters, 2);
+                    p->sub.filter = subf;
+                    ok = true;
+                }
+            }
+        }
+        if (!ok)
+            talloc_free(subf);
+    }
+#endif
+
     if (!p->sub.filter) {
         if (has_filter)
             MP_ERR(f, "creating deinterlacer failed\n");
