+
+// Software frames wrapped for the sink, through mpv's OWN scaler.
+//
+// This path is not an edge case: interlaced broadcast H.264 is never accepted by VideoToolbox, so
+// live TV decodes in software from the first frame; and any hardware session iOS reclaims — it
+// does that when the app is not in front — drops the file into software until the decoder is
+// rebuilt. Whatever the reason, the mirror only shows what this function can convert.
+//
+// It used to convert exactly one format, 8-bit `IMGFMT_420P`, by hand. Everything else returned
+// NULL, and a NULL here is not a dropped frame but a Picture in Picture window that goes black and
+// stays black while the app itself plays perfectly, because the app draws its own surface and never
+// comes through here (owner's device, 2026-07-30: Notification Center over a running PiP window).
+// 10-bit is the obvious next format, but hand-writing each one is how the first gap happened.
+// `mp_sws` already converts everything mpv can decode, so it does the work and the list of
+// supported formats stops being ours to maintain.
+static void *tap_wrap_sw_frame(struct vo *vo, struct mp_image *img)
+{
+    if (img->w <= 0 || img->h <= 0)
+        return NULL;
+    CFMutableDictionaryRef attrs = CFDictionaryCreateMutable(NULL, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionaryRef surf = CFDictionaryCreate(NULL, NULL, NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, surf);
+    CFRelease(surf);
+    CVPixelBufferRef pb = NULL;
+    CVReturn err = CVPixelBufferCreate(NULL, img->w, img->h,
+        kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange, attrs, &pb);
+    CFRelease(attrs);
+    if (err != kCVReturnSuccess || !pb)
+        return NULL;
+
+    if (!vo->in->tap_sws) {
+        // Kept for the life of the vo: the scaler caches its conversion for the format pair it
+        // last saw, and rebuilding one per frame would throw that away every time.
+        vo->in->tap_sws = mp_sws_alloc(vo->in);
+        mp_sws_enable_cmdline_opts(vo->in->tap_sws, vo->global);
+    }
+
+    bool ok = false;
+    if (CVPixelBufferLockBaseAddress(pb, 0) == kCVReturnSuccess) {
+        struct mp_image view;
+        // The SOURCE's colorimetry on the destination too, so this is a format conversion and not
+        // a colour conversion: the mirror must look like the picture the player is showing.
+        if (tap_view_nv12(pb, &view, &img->params))
+            ok = mp_sws_scale(vo->in->tap_sws, &view, img) >= 0;
+        CVPixelBufferUnlockBaseAddress(pb, 0);
+    }
+    if (!ok) {
+        CVPixelBufferRelease(pb);
+        return NULL;
+    }
+    return pb;
 }
 
