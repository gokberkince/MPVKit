--- a/video/out/vo.c
+++ b/video/out/vo.c
@@ -34,6 +34,20 @@
 #include "misc/bstr.h"
 #include "vo.h"
 
+#ifdef __APPLE__
+#include <CoreVideo/CoreVideo.h>
+
+// Fork addition (Lumen): hands every displayed VideoToolbox frame to the embedding app, which
+// feeds AVSampleBufferDisplayLayer for system Picture in Picture. Upstream has no AVFoundation
+// vo, and the client API exposes no decoded frames. The struct layout is ABI between this fork
+// and the app; the pointer passed via --vo-pixbuf-sink must outlive the vo, and the callback
+// receives the pixel buffer retained — releasing it is the callee's job. Called on the vo
+// thread; the callee must not block.
+struct mp_pixbuf_sink {
+    void (*frame)(void *ctx, void *cv_pixbuf, double pts_seconds);
+    void *ctx;
+};
+#endif
 #include "aspect.h"
 #include "dr_helper.h"
 #include "input/input.h"
@@ -121,6 +135,7 @@
 };
 
 struct vo_internal {
+    void *last_tapped_pixbuf;
     mp_thread thread;
     struct mp_dispatch_queue *dispatch;
     struct dr_helper *dr_helper;
@@ -912,7 +927,25 @@
             break;
     }
     mp_mutex_unlock(&in->lock);
+}
+
+#ifdef __APPLE__
+static void tap_pixbuf(struct vo *vo, struct vo_frame *frame)
+{
+    struct mp_pixbuf_sink *sink = (void *)(intptr_t)vo->opts->pixbuf_sink;
+    if (!sink || !sink->frame || !frame || !frame->current)
+        return;
+    struct mp_image *img = frame->current;
+    if (img->imgfmt != IMGFMT_VIDEOTOOLBOX || !img->planes[3])
+        return;
+    void *pixbuf = img->planes[3];
+    if (pixbuf == vo->in->last_tapped_pixbuf)
+        return;
+    vo->in->last_tapped_pixbuf = pixbuf;
+    CVPixelBufferRetain((CVPixelBufferRef)pixbuf);
+    sink->frame(sink->ctx, pixbuf, frame->pts / 1e9);
 }
+#endif
 
 static bool render_frame(struct vo *vo)
 {
@@ -1007,6 +1040,11 @@
 
         stats_time_start(in->stats, "video-draw");
 
+#ifdef __APPLE__
+        // Before the draw: the tap mirrors the DECODED frame, and drawing can stall on a
+        // background CAMetalLayer's drawable while PiP is exactly the consumer that must not.
+        tap_pixbuf(vo, frame);
+#endif
         in->visible = vo->driver->draw_frame(vo, frame);
 
         stats_time_end(in->stats, "video-draw");
