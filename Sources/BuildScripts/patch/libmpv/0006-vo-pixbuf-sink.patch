+
+#ifdef __APPLE__
+// Software frames wrapped for the sink: interlaced broadcast H.264 never hardware-decodes on
+// iOS — VideoToolbox does not accept field-coded streams — so live TV arrives as plain yuv420
+// and PiP would starve without this. IOSurface-backed NV12 so the display layer shows it
+// without a further conversion; one packed copy per frame is the price.
+static void *tap_wrap_sw_frame(struct mp_image *img)
+{
+    if (img->imgfmt != IMGFMT_420P || img->num_planes < 3)
+        return NULL;
+    CFMutableDictionaryRef attrs = CFDictionaryCreateMutable(NULL, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionaryRef surf = CFDictionaryCreate(NULL, NULL, NULL, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, surf);
+    CFRelease(surf);
+    CVPixelBufferRef pb = NULL;
+    CVReturn err = CVPixelBufferCreate(NULL, img->w, img->h,
+        kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange, attrs, &pb);
+    CFRelease(attrs);
+    if (err != kCVReturnSuccess || !pb)
+        return NULL;
+    CVPixelBufferLockBaseAddress(pb, 0);
+    uint8_t *dst_y = CVPixelBufferGetBaseAddressOfPlane(pb, 0);
+    size_t pitch_y = CVPixelBufferGetBytesPerRowOfPlane(pb, 0);
+    for (int y = 0; y < img->h; y++)
+        memcpy(dst_y + (size_t)y * pitch_y,
+               img->planes[0] + (ptrdiff_t)y * img->stride[0], img->w);
+    uint8_t *dst_uv = CVPixelBufferGetBaseAddressOfPlane(pb, 1);
+    size_t pitch_uv = CVPixelBufferGetBytesPerRowOfPlane(pb, 1);
+    int ch = (img->h + 1) / 2, cw = (img->w + 1) / 2;
+    for (int y = 0; y < ch; y++) {
+        const uint8_t *u = img->planes[1] + (ptrdiff_t)y * img->stride[1];
+        const uint8_t *v = img->planes[2] + (ptrdiff_t)y * img->stride[2];
+        uint8_t *row = dst_uv + (size_t)y * pitch_uv;
+        for (int x = 0; x < cw; x++) {
+            row[2 * x] = u[x];
+            row[2 * x + 1] = v[x];
+        }
+    }
+    CVPixelBufferUnlockBaseAddress(pb, 0);
+    return pb;
+}
+
+static void tap_pixbuf(struct vo *vo, struct vo_frame *frame)
+{
+    struct mp_pixbuf_sink *sink = (void *)(intptr_t)vo->opts->pixbuf_sink;
+    if (!sink || !sink->frame || !frame || !frame->current)
+        return;
+    struct mp_image *img = frame->current;
+    if (img == vo->in->last_tapped_pixbuf)
+        return;
+    vo->in->last_tapped_pixbuf = img;
+    void *pixbuf = NULL;
+    if (img->imgfmt == IMGFMT_VIDEOTOOLBOX && img->planes[3]) {
+        pixbuf = img->planes[3];
+        CVPixelBufferRetain((CVPixelBufferRef)pixbuf);
+    } else {
+        pixbuf = tap_wrap_sw_frame(img);
+    }
+    if (!pixbuf)
+        return;
+    sink->frame(sink->ctx, pixbuf, frame->pts / 1e9);
 }
+#endif
 
