+// Fork addition (Lumen): hands every displayed frame to the embedding app, which feeds
+// AVSampleBufferDisplayLayer for system Picture in Picture. Upstream has no AVFoundation vo,
+// and the client API exposes no decoded frames. The struct layout is ABI between this fork and
+// the app; the pointer passed via --vo-pixbuf-sink must outlive the vo, and the callback
+// receives the pixel buffer retained — releasing it is the callee's job. Called on the vo
+// thread; the callee must not block.
+struct mp_pixbuf_sink {
+    void (*frame)(void *ctx, void *cv_pixbuf, double pts_seconds);
+    void *ctx;
+};
+#endif
