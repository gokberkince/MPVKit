+
+// Fork addition (Lumen): puts hardware decoding back after the system took its session away.
+//
+// iOS reclaims a VideoToolbox session from an app that is not in front — pulling Notification
+// Center over a running Picture in Picture window does it — and reports `kVTInvalidSessionErr`,
+// "Server session is gone". Upstream reads that as "this method does not work here": three failed
+// frames set `hwdec_failed`, `force_fallback` moves to the next method, and because the spent one
+// stays in `attempted_hwdecs` it is never reconsidered. One pull-down therefore dropped the whole
+// file into software decoding (owner's device, 2026-07-30). Apple's own answer to that error is to
+// build a new session, which is what WebRTC's iOS decoder does.
+//
+// Gated on a KEYFRAME, and that is the whole pacing mechanism — there is no timer and nothing
+// polls. It is also the only point where a new session can start cleanly: a decoder rebuilt in the
+// middle of a GOP has no reference frames and produces the "Could not find ref with POC" wreckage
+// that was in the same log. A GOP is a second or two, so recovery lands on the first keyframe
+// after the system is willing, and until then software carries the picture.
+//
+// Separate from `force_fallback` on purpose. That function's contract is "go forward", and
+// upstream's proof that `receive_frame` cannot spin rests on `attempted_hwdecs` only ever growing;
+// re-entering it from a shrinking list is how a patched version of this broke that guarantee.
+// This one runs from `send_packet`, and leaves a working `avctx` on every path.
+static void try_restore_hwdec(struct mp_filter *vd)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+
+    for (int i = 0; i < ctx->num_attempted_hwdecs; i++) {
+        if (!bstr_equals(ctx->attempted_hwdecs[i], ctx->hwdec_succeeded))
+            continue;
+        talloc_free(ctx->attempted_hwdecs[i].start);
+        MP_TARRAY_REMOVE_AT(ctx->attempted_hwdecs, ctx->num_attempted_hwdecs, i);
+        break;
+    }
+
+    uninit_avctx(vd);
+    select_and_set_hwdec(vd);
+    init_avctx(vd);
+    if (ctx->avctx && ctx->use_hwdec) {
+        MP_WARN(vd, "Recovered %.*s: its session was gone, not its stream.\n",
+                BSTR_P(ctx->hwdec_succeeded));
+        return;
+    }
+
+    // It did not come up — the system is still refusing. Put a decoder back before returning:
+    // every caller of this treats a NULL `avctx` as end of stream. The name is still remembered,
+    // so the next keyframe asks again.
+    MP_VERBOSE(vd, "Hardware decoding still unavailable; continuing in software.\n");
+    uninit_avctx(vd);
     select_and_set_hwdec(vd);
     init_avctx(vd);
 }
