+    @autoreleasepool {
     YADIFVTContext *s = ctx->priv;
     YADIFContext *y = &s->yadif;
     int i;
@@ -168,6 +175,7 @@ static void filter(AVFilterContext *ctx, AVFrame *dst,
 
 exit:
